# SQLite en local (zero-config). Pour la prod, passer `provider` a "postgresql"
# dans prisma/schema.prisma et mettre ici une URL Postgres (Neon, Supabase, RDS...).
DATABASE_URL="file:./dev.db"

# Genere avec: openssl rand -base64 32
NEXTAUTH_SECRET="change-moi"
NEXTAUTH_URL="http://localhost:3000"

# Dossier local de stockage des photos (original + tamponnees)
STORAGE_DIR="./storage"

# User-Agent requis par la politique d'usage de Nominatim (OpenStreetMap)
# pour le geocodage inverse (lat/lon -> adresse)
NOMINATIM_USER_AGENT="Geolaky/0.1 (contact@example.com)"
