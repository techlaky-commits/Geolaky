// Provider SQLite pour un dev local sans dependance externe (zero-config).
// Pour la production, changer "provider" en "postgresql" et pointer
// DATABASE_URL vers une instance Postgres (Neon, Supabase, RDS...).
// Le schema (modeles, relations) reste identique dans les deux cas.
datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id        String    @id @default(cuid())
  email     String    @unique
  name      String?
  password  String
  createdAt DateTime  @default(now())
  projects  Project[]
}

model Project {
  id          String   @id @default(cuid())
  name        String
  address     String?
  description String?

  // Dossier SharePoint associe au projet (URL ou chemin). Stockage du lien
  // uniquement : aucune synchronisation reelle tant qu'aucune app Microsoft
  // Graph/SharePoint n'est enregistree pour ce compte (voir README).
  sharePointUrl String?

  ownerId     String
  owner       User     @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  photos      Photo[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Photo {
  id           String   @id @default(cuid())
  projectId    String
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  // "photo" ou "video". Les medias existants sont tous des photos (valeur
  // par defaut), donc retrocompatible sans migration de donnees.
  mediaType    String   @default("photo")

  // Chemins relatifs sous STORAGE_DIR. Pour une video : stampedPath pointe
  // vers le fichier video original lui-meme (pas de tampon incruste, une
  // video n'est pas retouchee comme une photo).
  originalPath String
  stampedPath  String
  durationSeconds Float?

  latitude     Float?
  longitude    Float?
  accuracy     Float?
  address      String?
  country      String?
  note         String?

  // Direction de prise de vue (GPSImgDirection EXIF), 0-360 degres, 0 = Nord.
  // Null si l'information n'est pas presente dans les metadonnees.
  direction    Float?

  // Parametres de recadrage/rotation appliques a l'original (JSON serialise)
  cropData     String?

  // Identifiant partage par les photos prises/importees dans le meme lot
  // (rafale mobile ou import groupe) : meme commentaire, affichage regroupe
  // sur la carte. Null pour une photo isolee.
  groupId      String?

  capturedAt   DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([projectId])
  @@index([groupId])
}
